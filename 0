/* ═══════════════════════════════════════════════════════════
   ANALYTICS
═══════════════════════════════════════════════════════════*/
function computeAnalytics(questions,answers,confidence,qTimes){
  // Subject
  const subMap={};
  questions.forEach((q,i)=>{
    const s=q.subject||'General';
    if(!subMap[s]) subMap[s]={name:s,total:0,correct:0};
    subMap[s].total++;
    if(answers[i]===q.correctIndex) subMap[s].correct++;
  });
  const subData=Object.values(subMap).map(m=>({...m,pct:pct(m.correct,m.total)})).sort((a,b)=>b.pct-a.pct);

  // Difficulty
  const diffMap={Easy:{t:0,c:0},Medium:{t:0,c:0},Hard:{t:0,c:0}};
  questions.forEach((q,i)=>{
    const d=q.difficulty||'Medium';
    if(!diffMap[d]) diffMap[d]={t:0,c:0};
    diffMap[d].t++; if(answers[i]===q.correctIndex) diffMap[d].c++;
  });
  const diffData=['Easy','Medium','Hard'].map(d=>({name:d,pct:pct(diffMap[d]?.c||0,diffMap[d]?.t||1),total:diffMap[d]?.t||0})).filter(d=>d.total>0);

  // Confidence
  const confMap={sure:{n:0,c:0},unsure:{n:0,c:0},guess:{n:0,c:0}};
  questions.forEach((q,i)=>{
    const cf=confidence[i]; if(!cf) return;
    confMap[cf]&&(confMap[cf].n++,answers[i]===q.correctIndex&&confMap[cf].c++);
  });

  // Slowest
  const slowest=[...questions.map((q,i)=>({stem:q.stem.slice(0,52)+'…',time:qTimes[i]||0,ok:answers[i]===q.correctIndex}))].sort((a,b)=>b.time-a.time).slice(0,5).filter(q=>q.time>0);

  // Weak
  const weak=subData.filter(s=>s.pct<60&&s.total>=2);

  return {subData,diffData,confMap,slowest,weak};
}

function renderAnalyticsHTML(questions,answers,confidence,qTimes){
  const {subData,diffData,confMap,slowest,weak}=computeAnalytics(questions,answers,confidence,qTimes);
  let html=`<div style="margin-top:22px"><div style="font-family:'Fraunces',serif;font-size:1.05rem;font-weight:700;margin-bottom:13px">📊 Performance Analytics</div>`;

  // Subject bars
  if(subData.length>1){
    html+=`<div class="chart-card"><div class="chart-lbl">SCORE BY SUBJECT</div>`;
    subData.forEach(s=>{
      const color=s.pct>=75?'var(--emerald)':s.pct>=50?'var(--amber)':'var(--rose)';
      html+=`<div class="bar-row">
        <div class="bar-label">${esc(s.name)}</div>
        <div class="bar-track">
          <div class="bar-fill" style="width:${s.pct}%;background:${color}">
            <span class="bar-pct">${s.pct}%</span>
          </div>
        </div>
        <div style="font-family:'DM Mono',monospace;font-size:.66rem;color:var(--muted);min-width:40px;text-align:right">${s.correct}/${s.total}</div>
      </div>`;
    });
    html+=`</div>`;
  }

  // Difficulty circles
  if(diffData.length){
    html+=`<div class="chart-card"><div class="chart-lbl">BY DIFFICULTY</div><div class="diff-bars">`;
    diffData.forEach(d=>{
      const color=DIFF_COLORS[d.name]||'var(--muted)';
      html+=`<div class="diff-bar-item">
        <div class="diff-circle" style="background:${color}">${d.pct}%</div>
        <div class="diff-name">${d.name}</div>
        <div class="diff-sub">${d.total} Qs</div>
      </div>`;
    });
    html+=`</div></div>`;
  }

  // Confidence accuracy
  const confEntries=[{k:'sure',l:'Sure ✓'},{k:'unsure',l:'~ Unsure'},{k:'guess',l:'? Guess'}].filter(c=>confMap[c.k].n>0);
  if(confEntries.length){
    html+=`<div class="chart-card"><div class="chart-lbl">CONFIDENCE ACCURACY</div>`;
    confEntries.forEach(c=>{
      const m=confMap[c.k];
      const p=pct(m.c,m.n);
      const color=p>=75?'var(--emerald)':p>=50?'var(--amber)':'var(--rose)';
      html+=`<div class="bar-row">
        <div class="bar-label">${c.l} (${m.n})</div>
        <div class="bar-track">
          <div class="bar-fill" style="width:${p}%;background:${color}">
            <span class="bar-pct">${p}%</span>
          </div>
        </div>
      </div>`;
    });
    html+=`</div>`;
  }

  // Slowest
  if(slowest.length){
    html+=`<div class="chart-card"><div class="chart-lbl">SLOWEST QUESTIONS (time spent)</div>`;
    slowest.forEach((q,i)=>{
      html+=`<div style="display:flex;align-items:center;gap:8px;margin-bottom:6px">
        <span style="font-family:'DM Mono',monospace;font-size:.66rem;color:var(--muted);min-width:20px">${i+1}.</span>
        <span style="flex:1;font-size:.79rem;line-height:1.4">${esc(q.stem)}</span>
        <span style="font-family:'DM Mono',monospace;font-size:.72rem;font-weight:600;color:${q.ok?'var(--emerald)':'var(--rose)'};white-space:nowrap">${q.time}s</span>
      </div>`;
    });
    html+=`</div>`;
  }

  // Weak
  if(weak.length){
    html+=`<div class="chart-card"><div class="chart-lbl">⚠️ WEAK AREAS (below 60%)</div>`;
    weak.forEach(s=>{
      html+=`<div class="weak-item">
        <span class="weak-name">${esc(s.name)}</span>
        <span style="font-family:'DM Mono',monospace;font-size:.72rem;color:var(--muted)">${s.correct}/${s.total}</span>
        <span class="weak-pct">${s.pct}%</span>
      </div>`;
    });
    html+=`</div>`;
  }

  html+=`</div>`;
  return html;
}

