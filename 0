<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1"/>
<meta name="theme-color" content="#0f0e0d"/>
<meta name="apple-mobile-web-app-capable" content="yes"/>
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent"/>
<meta name="apple-mobile-web-app-title" content="MedQuiz PRO"/>
<meta name="description" content="USMLE-style MCQ practice app for medical students"/>
<title>MedQuiz PRO</title>

<link rel="manifest" href="data:application/json,{&quot;name&quot;:&quot;MedQuiz PRO&quot;,&quot;short_name&quot;:&quot;MedQuiz&quot;,&quot;start_url&quot;:&quot;.&quot;,&quot;display&quot;:&quot;standalone&quot;,&quot;background_color&quot;:&quot;%230f0e0d&quot;,&quot;theme_color&quot;:&quot;%230f0e0d&quot;,&quot;icons&quot;:[{&quot;src&quot;:&quot;data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 512 512'%3E%3Crect width='512' height='512' rx='80' fill='%230f0e0d'/%3E%3Ctext x='256' y='340' font-size='280' text-anchor='middle' fill='%23d97706'%3E✚%3C/text%3E%3C/svg%3E&quot;,&quot;sizes&quot;:&quot;512x512&quot;,&quot;type&quot;:&quot;image/svg+xml&quot;}]}"/>

<style>
@import url('https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;0,9..144,700;1,9..144,400&family=DM+Mono:wght@400;500&family=Instrument+Sans:wght@400;500;600&display=swap');

*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
:root{
  --ink:#0f0e0d;--paper:#f7f4ef;--cream:#edeae2;--white:#fff;
  --amber:#c77c00;--amber-lt:#fef3c7;--amber-dk:#92400e;
  --emerald:#047857;--em-lt:#d1fae5;
  --rose:#c81e4a;--rose-lt:#ffe4e6;
  --sky:#0369a1;--sky-lt:#e0f2fe;
  --violet:#6d28d9;--violet-lt:#ede9fe;
  --orange:#ea580c;--orange-lt:#fff7ed;
  --muted:#6b6560;--border:#d8d3ca;--border-dk:#b5afa5;
  --shadow:0 1px 6px rgba(0,0,0,.08),0 1px 2px rgba(0,0,0,.05);
  --shadow-md:0 4px 16px rgba(0,0,0,.1),0 1px 4px rgba(0,0,0,.06);
  --shadow-lg:0 8px 32px rgba(0,0,0,.13),0 2px 8px rgba(0,0,0,.07);
  --r:14px;--sb:260px;
}

html{height:100%;scroll-behavior:smooth}
body{font-family:'Instrument Sans',sans-serif;background:var(--paper);color:var(--ink);min-height:100%;overscroll-behavior:none}

/* ── SCROLLBARS ── */
::-webkit-scrollbar{width:4px;height:4px}
::-webkit-scrollbar-track{background:transparent}
::-webkit-scrollbar-thumb{background:var(--border);border-radius:99px}

/* ── TOPBAR ── */
#topbar{position:sticky;top:0;z-index:100;background:var(--paper);border-bottom:2px solid var(--ink);display:flex;align-items:center;gap:10px;padding:12px 16px;backdrop-filter:blur(8px)}
.logo{font-family:'Fraunces',serif;font-size:1.3rem;font-weight:700;letter-spacing:-.03em;white-space:nowrap}
.logo em{color:var(--amber);font-style:normal}
.logo sup{font-size:.48rem;color:var(--muted);font-family:'DM Mono',monospace;vertical-align:super;margin-left:1px}
.topbar-mid{flex:1}
.nav-badge{font-family:'DM Mono',monospace;font-size:.62rem;background:var(--ink);color:var(--paper);padding:3px 8px;border-radius:4px;letter-spacing:.04em}
.autosave-indicator{font-family:'DM Mono',monospace;font-size:.62rem;color:var(--emerald);display:flex;align-items:center;gap:3px;opacity:0;transition:opacity .3s}
.autosave-indicator.show{opacity:1}
.autosave-indicator.saving{color:var(--amber)}

/* ── LAYOUT ── */
#app{max-width:1060px;margin:0 auto;padding:20px 14px 90px}
.screen{display:none}.screen.active{display:block;animation:fadeUp .28s ease}

/* TEST LAYOUT */
.test-layout{display:flex;gap:0;align-items:flex-start}
.test-main{flex:1;min-width:0}
.sidebar{width:var(--sb);flex-shrink:0;margin-left:16px;position:sticky;top:72px;max-height:calc(100vh - 90px);display:flex;flex-direction:column;border:1.5px solid var(--border);border-radius:var(--r);overflow:hidden;box-shadow:var(--shadow-md);background:var(--white)}

/* SIDEBAR INTERNALS */
.sb-head{padding:11px 13px;border-bottom:1.5px solid var(--border);background:var(--ink);color:var(--paper);flex-shrink:0}
.sb-title{font-family:'DM Mono',monospace;font-size:.65rem;letter-spacing:.08em;margin-bottom:5px}
.sb-stats{display:flex;gap:6px;flex-wrap:wrap}
.sb-stat{font-family:'DM Mono',monospace;font-size:.66rem;padding:2px 7px;border-radius:4px}
.sb-stat-ans{background:rgba(255,255,255,.18);color:#fff}
.sb-stat-left{background:rgba(255,255,255,.1);color:rgba(255,255,255,.7)}
.sb-stat-flag{background:#fef3c7;color:#92400e}
.sb-grid{overflow-y:auto;padding:9px;display:grid;grid-template-columns:repeat(5,1fr);gap:5px;flex:1}
.sq{width:100%;aspect-ratio:1;display:flex;align-items:center;justify-content:center;border-radius:6px;font-family:'DM Mono',monospace;font-size:.7rem;font-weight:500;cursor:pointer;border:1.5px solid var(--border);background:var(--cream);color:var(--muted);transition:all .14s;user-select:none}
.sq:hover{border-color:var(--amber);color:var(--amber);transform:scale(1.06)}
.sq.cur{border-color:var(--amber);background:var(--amber);color:#fff;transform:scale(1.1);font-weight:700}
.sq.answered{background:var(--ink);border-color:var(--ink);color:var(--paper)}
.sq.correct{background:var(--emerald);border-color:var(--emerald);color:#fff}
.sq.wrong{background:var(--rose);border-color:var(--rose);color:#fff}
.sq.f-review{background:var(--amber-lt);border-color:var(--amber);color:var(--amber-dk)}
.sq.f-unsure{background:var(--violet-lt);border-color:var(--violet);color:var(--violet)}
.sq.f-skip{background:var(--orange-lt);border-color:var(--orange);color:var(--orange)}
.sb-legend{padding:9px 11px;border-top:1.5px solid var(--border);display:flex;flex-direction:column;gap:4px;background:var(--cream);flex-shrink:0}
.leg-row{display:flex;align-items:center;gap:5px;font-size:.67rem;color:var(--muted);font-family:'DM Mono',monospace}
.leg-dot{width:9px;height:9px;border-radius:2px;flex-shrink:0}

/* ── CARDS ── */
.card{background:var(--white);border:1.5px solid var(--border);border-radius:var(--r);padding:22px;box-shadow:var(--shadow);margin-bottom:14px}
.card-title{font-family:'Fraunces',serif;font-size:1rem;font-weight:700;margin-bottom:3px}
.card-sub{font-size:.77rem;color:var(--muted);margin-bottom:14px;line-height:1.5}

/* ── TABS ── */
.tabs{display:flex;gap:3px;background:var(--cream);padding:3px;border-radius:10px;margin-bottom:18px}
.tab{flex:1;padding:7px;border-radius:7px;font-size:.78rem;font-weight:600;cursor:pointer;border:none;background:transparent;color:var(--muted);transition:all .15s;text-align:center;font-family:'Instrument Sans',sans-serif;white-space:nowrap}
.tab.active{background:var(--white);color:var(--ink);box-shadow:var(--shadow)}
.input-tabs{display:flex;border:1.5px solid var(--border);border-radius:9px;overflow:hidden;margin-bottom:13px}
.itab{flex:1;padding:8px;font-size:.79rem;font-weight:600;cursor:pointer;border:none;background:transparent;color:var(--muted);font-family:'Instrument Sans',sans-serif}
.itab.on{background:var(--ink);color:var(--paper)}

/* ── BUTTONS ── */
.btn{display:inline-flex;align-items:center;gap:6px;padding:9px 18px;border-radius:9px;font-family:'Instrument Sans',sans-serif;font-size:.84rem;font-weight:600;cursor:pointer;border:1.5px solid transparent;transition:all .17s;user-select:none}
.btn-ink{background:var(--ink);color:var(--paper)}.btn-ink:hover{background:#2d2b28;transform:translateY(-1px);box-shadow:var(--shadow)}
.btn-amber{background:var(--amber);color:#fff}.btn-amber:hover{background:#a36500;transform:translateY(-1px)}
.btn-outline{background:transparent;color:var(--ink);border-color:var(--border)}.btn-outline:hover{border-color:var(--ink);background:var(--cream)}
.btn-ghost{background:transparent;color:var(--muted);border-color:transparent;font-size:.79rem}.btn-ghost:hover{color:var(--ink);background:var(--cream)}
.btn-em{background:var(--emerald);color:#fff}.btn-em:hover{background:#065f46}
.btn-rose{background:var(--rose);color:#fff}.btn-rose:hover{background:#9f1239}
.btn-sm{padding:5px 11px;font-size:.76rem}
.btn:disabled{opacity:.38;cursor:not-allowed;transform:none!important;box-shadow:none!important}
.btn-group{display:flex;gap:7px;flex-wrap:wrap;align-items:center}

/* ── UPLOAD ── */
.upload-zone{border:2px dashed var(--border);border-radius:11px;padding:30px 18px;text-align:center;cursor:pointer;transition:all .2s;background:var(--cream)}
.upload-zone:hover,.upload-zone.drag{border-color:var(--amber);background:var(--amber-lt)}
.upload-icon{font-size:2rem;margin-bottom:7px}
.upload-title{font-family:'Fraunces',serif;font-size:1rem;font-weight:600;margin-bottom:4px}
.upload-sub{font-size:.76rem;color:var(--muted)}
.paste-area{width:100%;min-height:105px;padding:11px;font-family:'DM Mono',monospace;font-size:.73rem;border:1.5px solid var(--border);border-radius:9px;background:var(--cream);color:var(--ink);outline:none;resize:vertical;line-height:1.65}
.paste-area:focus{border-color:var(--amber)}

/* ── FILTER PILLS ── */
.filter-row{display:flex;gap:5px;flex-wrap:wrap;margin-bottom:9px}
.fpill{padding:4px 11px;border-radius:99px;border:1.5px solid var(--border);font-size:.72rem;font-family:'DM Mono',monospace;cursor:pointer;background:var(--cream);transition:all .13s;color:var(--muted)}
.fpill:hover{border-color:var(--amber);color:var(--amber)}
.fpill.on{background:var(--ink);border-color:var(--ink);color:var(--paper)}

/* ── Q PREVIEW LIST ── */
.q-list{display:flex;flex-direction:column;gap:6px;max-height:270px;overflow-y:auto;padding-right:3px}
.q-item{display:flex;align-items:flex-start;gap:8px;padding:8px 11px;border:1.5px solid var(--border);border-radius:8px;background:var(--cream);font-size:.78rem}
.q-num{font-family:'DM Mono',monospace;font-size:.68rem;color:var(--muted);min-width:22px;padding-top:1px}
.q-text{flex:1;line-height:1.4}

/* ── TAGS ── */
.tag{display:inline-block;font-family:'DM Mono',monospace;font-size:.63rem;padding:2px 6px;border-radius:4px;white-space:nowrap}
.tag-sub{background:var(--ink);color:var(--paper)}
.tag-easy{background:var(--em-lt);color:var(--emerald)}
.tag-medium{background:var(--amber-lt);color:var(--amber-dk)}
.tag-hard{background:var(--rose-lt);color:var(--rose)}
.tag-sky{background:var(--sky-lt);color:var(--sky)}
.tag-violet{background:var(--violet-lt);color:var(--violet)}
.tag-muted{background:var(--cream);color:var(--muted);border:1px solid var(--border)}

/* ── MODE CARDS ── */
.mode-grid{display:grid;grid-template-columns:1fr 1fr;gap:11px;margin-top:11px}
.mode-card{border:2px solid var(--border);border-radius:11px;padding:17px;cursor:pointer;transition:all .17s;background:var(--cream);position:relative;overflow:hidden}
.mode-card:hover{border-color:var(--amber);background:var(--amber-lt)}
.mode-card.sel{border-color:var(--amber);background:var(--amber-lt)}
.mode-card.sel::after{content:'✓';position:absolute;top:9px;right:11px;font-size:.85rem;color:var(--amber);font-weight:700}
.mode-icon{font-size:1.5rem;margin-bottom:7px}
.mode-name{font-family:'Fraunces',serif;font-size:.9rem;font-weight:700;margin-bottom:2px}
.mode-desc{font-size:.72rem;color:var(--muted);line-height:1.5}

/* ── TIMER ── */
.timer-wrap{display:flex;flex-direction:column;align-items:flex-end;gap:3px}
.timer-bar-bg{width:120px;height:5px;background:var(--border);border-radius:99px;overflow:hidden}
.timer-bar{height:100%;border-radius:99px;transition:width 1s linear,background .4s}
.timer-txt{font-family:'DM Mono',monospace;font-size:.83rem;font-weight:500}
.timer-txt.warn{color:var(--rose);animation:pulse 1s infinite}

/* ── QUESTION CARD ── */
.q-card{background:var(--white);border:1.5px solid var(--border);border-radius:16px;padding:26px 24px 20px;box-shadow:var(--shadow-lg);margin-bottom:14px}
.q-meta{display:flex;justify-content:space-between;align-items:center;margin-bottom:15px;flex-wrap:wrap;gap:7px}
.q-meta-l{display:flex;gap:5px;align-items:center;flex-wrap:wrap}
.q-num-lbl{font-family:'DM Mono',monospace;font-size:.68rem;color:var(--muted)}
.q-stem{font-family:'Fraunces',serif;font-size:1.05rem;font-weight:600;line-height:1.7;color:var(--ink);margin-bottom:20px}
.options{display:flex;flex-direction:column;gap:7px}
.opt{display:flex;align-items:flex-start;gap:11px;padding:12px 14px;border:2px solid var(--border);border-radius:10px;cursor:pointer;transition:all .15s;background:var(--cream);font-size:.87rem;line-height:1.5;user-select:none}
.opt:hover:not(.dis){border-color:var(--amber);background:var(--amber-lt)}
.opt.picked:not(.rev){border-color:var(--ink);background:var(--ink);color:var(--paper)}
.opt.correct{border-color:var(--emerald)!important;background:var(--em-lt)!important;color:var(--ink)}
.opt.wrong{border-color:var(--rose)!important;background:var(--rose-lt)!important;color:var(--ink)}
.opt.dis{cursor:default}
.opt-ltr{font-family:'DM Mono',monospace;font-size:.73rem;font-weight:500;min-width:18px;padding-top:1px;flex-shrink:0}

/* ── FLAG PANEL ── */
.flag-panel{margin-top:14px;padding:11px 13px;background:var(--cream);border-radius:9px;border:1.5px solid var(--border)}
.flag-panel-title{font-family:'DM Mono',monospace;font-size:.64rem;color:var(--muted);margin-bottom:7px;letter-spacing:.05em}
.flag-opts{display:flex;gap:5px;flex-wrap:wrap}
.flag-opt{padding:5px 11px;border-radius:99px;border:1.5px solid var(--border);font-size:.73rem;cursor:pointer;background:var(--white);transition:all .14s;font-family:'DM Mono',monospace;display:flex;align-items:center;gap:4px}
.flag-opt:hover{transform:translateY(-1px);box-shadow:var(--shadow)}
.flag-opt.f-none.on{background:var(--cream);border-color:var(--border-dk);color:var(--muted)}
.flag-opt.f-review.on{background:var(--amber-lt);border-color:var(--amber);color:var(--amber-dk)}
.flag-opt.f-unsure.on{background:var(--violet-lt);border-color:var(--violet);color:var(--violet)}
.flag-opt.f-skip.on{background:var(--orange-lt);border-color:var(--orange);color:var(--orange)}

/* ── CONFIDENCE ── */
.conf-row{display:flex;gap:5px;margin-top:11px;align-items:center;flex-wrap:wrap}
.conf-lbl{font-size:.7rem;color:var(--muted);font-family:'DM Mono',monospace;margin-right:2px}
.conf-btn{padding:4px 10px;border-radius:99px;border:1.5px solid var(--border);font-size:.7rem;cursor:pointer;background:var(--white);transition:all .13s;font-family:'DM Mono',monospace}
.conf-btn.c-sure{background:var(--em-lt);border-color:var(--emerald);color:var(--emerald)}
.conf-btn.c-unsure{background:var(--amber-lt);border-color:var(--amber);color:var(--amber-dk)}
.conf-btn.c-guess{background:var(--rose-lt);border-color:var(--rose);color:var(--rose)}

/* ── EXPLANATION ── */
.explanation{margin-top:14px;padding:13px 15px;background:var(--cream);border-left:4px solid var(--amber);border-radius:0 9px 9px 0;font-size:.84rem;line-height:1.65;animation:slideIn .22s ease}
.expl-lbl{font-family:'DM Mono',monospace;font-size:.64rem;color:var(--amber);margin-bottom:5px;font-weight:500;letter-spacing:.07em}

/* ── NAV ROW ── */
.nav-row{display:flex;align-items:center;justify-content:space-between;gap:8px}

/* ── RESULTS ── */
.result-hero{text-align:center;padding:28px 20px 20px}
.big-score{font-family:'Fraunces',serif;font-size:4.2rem;font-weight:700;line-height:1;letter-spacing:-.04em}
.result-lbl{font-size:.88rem;color:var(--muted);margin-top:4px}
.grade-pill{display:inline-block;padding:4px 15px;border-radius:99px;font-weight:700;font-size:.77rem;margin-top:10px}
.ga{background:var(--em-lt);color:var(--emerald)}.gb{background:var(--amber-lt);color:var(--amber-dk)}.gc{background:var(--rose-lt);color:var(--rose)}
.stat-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin:16px 0}
.stat-box{background:var(--cream);border:1.5px solid var(--border);border-radius:10px;padding:13px;text-align:center}
.sv{font-family:'Fraunces',serif;font-size:1.55rem;font-weight:700}
.sv.g{color:var(--emerald)}.sv.r{color:var(--rose)}.sv.m{color:var(--muted)}.sv.b{color:var(--sky)}
.sl{font-size:.68rem;color:var(--muted);margin-top:2px}

/* ── ANALYTICS ── */
.chart-card{background:var(--white);border:1.5px solid var(--border);border-radius:var(--r);padding:17px 19px;box-shadow:var(--shadow);margin-bottom:12px}
.chart-lbl{font-size:.68rem;color:var(--muted);margin-bottom:11px;font-family:'DM Mono',monospace;letter-spacing:.05em}
.bar-row{display:flex;align-items:center;gap:9px;margin-bottom:8px}
.bar-label{font-size:.78rem;min-width:110px;text-align:right;line-height:1.3;font-family:'DM Mono',monospace;font-size:.68rem;color:var(--muted)}
.bar-track{flex:1;height:20px;background:var(--cream);border-radius:6px;overflow:hidden;position:relative}
.bar-fill{height:100%;border-radius:6px;transition:width .6s ease;display:flex;align-items:center;justify-content:flex-end;padding-right:7px}
.bar-pct{font-family:'DM Mono',monospace;font-size:.66rem;color:#fff;font-weight:600;white-space:nowrap}
.bar-row-mini{display:flex;align-items:center;gap:7px;margin-bottom:6px}
.diff-bars{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.diff-bar-item{text-align:center}
.diff-circle{width:54px;height:54px;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 5px;font-family:'Fraunces',serif;font-size:1rem;font-weight:700;color:#fff}
.diff-name{font-family:'DM Mono',monospace;font-size:.65rem;color:var(--muted)}
.diff-sub{font-family:'DM Mono',monospace;font-size:.62rem;color:var(--muted)}
.weak-item{display:flex;align-items:center;gap:8px;padding:8px 11px;border-radius:8px;background:var(--rose-lt);margin-bottom:6px}
.weak-name{flex:1;font-size:.8rem;font-weight:600}
.weak-pct{font-family:'DM Mono',monospace;font-size:.74rem;color:var(--rose);font-weight:700}

/* ── HISTORY ── */
.hist-item{border:1.5px solid var(--border);border-radius:11px;padding:13px 15px;margin-bottom:9px;cursor:pointer;transition:all .15s;background:var(--white)}
.hist-item:hover{border-color:var(--amber);box-shadow:var(--shadow)}
.hist-top{display:flex;align-items:center;gap:9px;margin-bottom:5px}
.hist-score{font-family:'Fraunces',serif;font-size:1.35rem;font-weight:700}
.hist-date{font-family:'DM Mono',monospace;font-size:.66rem;color:var(--muted)}
.hist-chips{display:flex;gap:4px;flex-wrap:wrap}
.hist-chip{font-family:'DM Mono',monospace;font-size:.63rem;padding:2px 6px;border-radius:4px;background:var(--cream);border:1px solid var(--border);color:var(--muted)}

/* ── REVIEW ── */
.review-item{border:1.5px solid var(--border);border-radius:11px;overflow:hidden;margin-bottom:9px}
.review-hdr{display:flex;align-items:center;gap:7px;padding:11px 14px;cursor:pointer;background:var(--cream);transition:background .14s}
.review-hdr:hover{background:var(--amber-lt)}
.rstatus{width:18px;height:18px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:.65rem;flex-shrink:0;font-weight:700}
.rs-ok{background:var(--em-lt);color:var(--emerald)}.rs-bad{background:var(--rose-lt);color:var(--rose)}.rs-skip{background:var(--border);color:var(--muted)}
.review-q{font-size:.83rem;font-family:'Fraunces',serif;flex:1;line-height:1.4}
.review-body{padding:12px 14px;border-top:1px solid var(--border);display:none}
.review-body.open{display:block}
.ropt{padding:6px 10px;border-radius:7px;font-size:.8rem;margin-bottom:4px}
.ropt.correct{background:var(--em-lt);color:var(--emerald);font-weight:600}
.ropt.wrong{background:var(--rose-lt);color:var(--rose)}
.rmeta{display:flex;gap:4px;margin-bottom:7px;flex-wrap:wrap}

/* ── FORMAT BOX ── */
.format-box{background:var(--cream);border:1.5px solid var(--border);border-radius:9px;padding:13px 15px;font-family:'DM Mono',monospace;font-size:.71rem;line-height:1.9;white-space:pre-wrap;word-break:break-all}
.copy-btn{display:inline-flex;align-items:center;gap:5px;font-family:'DM Mono',monospace;font-size:.7rem;padding:4px 10px;border-radius:6px;border:1.5px solid var(--border);background:var(--cream);cursor:pointer;transition:all .13s}
.copy-btn:hover{background:var(--ink);color:var(--paper);border-color:var(--ink)}

/* ── MISC ── */
.row{display:flex;gap:7px;align-items:center;flex-wrap:wrap}
.spacer{flex:1}
