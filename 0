<div id="toast"></div>
<script>
/* ═══════════════════════════════════════════════════════════
   PAPAPARSE MINI (essential subset, self-contained)
═══════════════════════════════════════════════════════════*/
const Papa = (function(){
  function parse(input, cfg){
    cfg = cfg||{};
    const header = cfg.header!==false;
    const skipEmpty = cfg.skipEmptyLines!==false;
    const lines = input.replace(/\r\n/g,'\n').replace(/\r/g,'\n').split('\n');
    const data=[];
    let headers=[];
    lines.forEach((line,li)=>{
      if(skipEmpty&&!line.trim()) return;
      const row = parseLine(line);
      if(li===0&&header){ headers=row; return; }
      if(header){
        const obj={};
        headers.forEach((h,i)=>{ obj[h.trim()]=row[i]!==undefined?row[i]:''; });
        data.push(obj);
      } else { data.push(row); }
    });
    return {data};
  }
  function parseLine(line){
    const cols=[]; let cur=''; let inQ=false;
    for(let i=0;i<line.length;i++){
      const c=line[i];
      if(c==='"'){
        if(inQ&&line[i+1]==='"'){cur+='"';i++;}
        else inQ=!inQ;
      } else if(c===','&&!inQ){ cols.push(cur.trim()); cur=''; }
      else cur+=c;
    }
    cols.push(cur.trim());
    return cols;
  }
  return {parse};
})();

/* ═══════════════════════════════════════════════════════════
   STORAGE  (localStorage with JSON)
═══════════════════════════════════════════════════════════*/
const DB = {
  get(key){ try{ const v=localStorage.getItem(key); return v?JSON.parse(v):null; }catch{return null;} },
  set(key,val){ try{ localStorage.setItem(key,JSON.stringify(val)); return true; }catch{return false;} },
  del(key){ try{ localStorage.removeItem(key); return true; }catch{return false;} },
  list(prefix){
    const keys=[];
    for(let i=0;i<localStorage.length;i++){
      const k=localStorage.key(i);
      if(k&&k.startsWith(prefix)) keys.push(k);
    }
    return keys;
  }
};

/* ═══════════════════════════════════════════════════════════
   CONSTANTS
═══════════════════════════════════════════════════════════*/
const LETTERS=['A','B','C','D','E'];
const DIFF_MAP={easy:'Easy',medium:'Medium',hard:'Hard',Easy:'Easy',Medium:'Medium',Hard:'Hard'};
const DIFF_COLORS={Easy:'#047857',Medium:'#c77c00',Hard:'#c81e4a'};
const FLAG_TYPES=[
  {key:'none', label:'Clear', icon:'✕', cls:'f-none'},
  {key:'review',label:'Review',icon:'🔖',cls:'f-review'},
  {key:'unsure',label:'Unsure',icon:'❓',cls:'f-unsure'},
  {key:'skip',  label:'Skip',  icon:'⏭',cls:'f-skip'},
];
const AI_PROMPT=`Generate MCQs on [TOPIC] in CSV format with EXACTLY these columns:

question,option_a,option_b,option_c,option_d,answer,explanation,subject,difficulty

Rules:
- answer must be exactly A, B, C, or D
- difficulty must be exactly: Easy, Medium, or Hard
- explanation: 1-2 clear educational sentences
- subject: sub-topic or chapter name
- Return ONLY the raw CSV, no markdown, no extra text

Example:
question,option_a,option_b,option_c,option_d,answer,explanation,subject,difficulty
"Which nerve causes wrist drop?",Ulnar,Radial,Median,Musculocutaneous,B,"Radial nerve injury at the spiral groove causes wrist drop.",Neurology,Medium`;

/* ═══════════════════════════════════════════════════════════
   GLOBAL APP STATE
═══════════════════════════════════════════════════════════*/
let APP = {
  screen: 'import',
  questions: [],
  filteredQs: [],
  mode: 'timed',
  minutes: 30,
  // test state
  idx: 0,
  answers: [],
  revealed: [],
  confidence: [],
  flags: [],
  qTimes: [],
  timeLeft: null,
  timerInterval: null,
  autoSaveInterval: null,
  sessionKey: null,
  sessionStart: null,
  qStart: null,
  // results
  result: null,
};

/* ═══════════════════════════════════════════════════════════
   HELPERS
═══════════════════════════════════════════════════════════*/
function fmtTime(s){
  if(s==null||isNaN(s)) return '—';
  const m=Math.floor(s/60),sc=s%60;
  return `${m}:${sc.toString().padStart(2,'0')}`;
}
function pct(n,d){ return d===0?0:Math.round((n/d)*100); }
function dateStr(ts){
  const d=new Date(ts);
  return d.toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'})+' '+
         d.toLocaleTimeString('en-US',{hour:'2-digit',minute:'2-digit'});
}
function shuffle(arr){
  const a=[...arr];
  for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]];}
  return a;
}
function diffTagCls(d){ return d==='Easy'?'tag-easy':d==='Hard'?'tag-hard':'tag-medium'; }
function esc(s){ return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

function toast(msg,dur=2400){
  const t=document.getElementById('toast');
  t.textContent=msg; t.classList.add('show');
  setTimeout(()=>t.classList.remove('show'),dur);
}

function showAutosave(state){
  const el=document.getElementById('autosave-ind');
  if(!el) return;
  el.textContent=state==='saving'?'⟳ Saving…':'✓ Saved';
  el.className='autosave-indicator show'+(state==='saving'?' saving':'');
  if(state==='saved') setTimeout(()=>el.classList.remove('show'),2500);
}

function parseCSV(text){
  const {data}=Papa.parse(text.trim(),{header:true,skipEmptyLines:true});
  return data.map((row,i)=>{
    const opts=[];
    ['option_a','option_b','option_c','option_d','option_e'].forEach(k=>{
      if((row[k]||'').trim()) opts.push(row[k].trim());
    });
    const ans=(row.answer||'').trim().toUpperCase();
    const ci=LETTERS.indexOf(ans);
    const rawDiff=(row.difficulty||row.Difficulty||'medium').trim();
    return {
      id:i,
      stem:(row.question||row.stem||'').trim(),
      options:opts,
      correctIndex:ci>=0?ci:0,
      explanation:(row.explanation||'').trim(),
      subject:(row.subject||row.topic||'').trim(),
      difficulty:DIFF_MAP[rawDiff]||'Medium',
    };
  }).filter(q=>q.stem&&q.options.length>=2);
}

/* ═══════════════════════════════════════════════════════════
   SCREEN MANAGEMENT
═══════════════════════════════════════════════════════════*/
function goTo(screen){
  document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active'));
  document.getElementById('screen-'+screen).classList.add('active');
  APP.screen=screen;
  const badge={import:'SETUP',test:'IN PROGRESS',results:'RESULTS'}[screen]||'';
  document.getElementById('nav-badge').textContent=badge;
  document.getElementById('home-btn').style.display=screen!=='import'?'':'none';
  window.scrollTo(0,0);
}
function goHome(){
  clearInterval(APP.timerInterval);
  clearInterval(APP.autoSaveInterval);
  APP.timerInterval=null;
  APP.autoSaveInterval=null;
  renderImport();
  goTo('import');
}

/* ═══════════════════════════════════════════════════════════
   IMPORT SCREEN
═══════════════════════════════════════════════════════════*/
let importState={
  questions:[],tab:'file',mainTab:'load',
  filterSubs:[],filterDiffs:[],numQ:'',
  pasteText:'',showFmt:false,mode:'timed',minutes:30,doShuffle:false,
  error:''
};

function renderImport(){
  const st=importState;
  const subjects=[...new Set(st.questions.map(q=>q.subject).filter(Boolean))];
  const diffs=[...new Set(st.questions.map(q=>q.difficulty).filter(Boolean))];
  let filtered=st.questions;
  if(st.filterSubs.length) filtered=filtered.filter(q=>st.filterSubs.includes(q.subject));
  if(st.filterDiffs.length) filtered=filtered.filter(q=>st.filterDiffs.includes(q.difficulty));
  if(st.numQ&&parseInt(st.numQ)>0) filtered=filtered.slice(0,parseInt(st.numQ));
  importState._filtered=filtered;

  // history
  const sessions=loadSessions();

  document.getElementById('screen-import').innerHTML=`
  <div class="tabs" style="max-width:460px">
    <button class="tab ${st.mainTab==='load'?'active':''}" onclick="importTab('load')">📋 Load Questions</button>
    <button class="tab ${st.mainTab==='history'?'active':''}" onclick="importTab('history')">
      🕐 History${sessions.length?` (${sessions.length})`:''}
    </button>
  </div>

  ${st.mainTab==='history'?renderHistory(sessions):`
  <!-- Load Tab -->
  <div class="card">
    <div class="card-title">Import Questions</div>
    <div class="card-sub">Upload a .csv file or paste CSV text directly.</div>
    <div class="input-tabs">
      <button class="itab ${st.tab==='file'?'on':''}" onclick="setImportTab('file')">📁 Upload File</button>
      <button class="itab ${st.tab==='paste'?'on':''}" onclick="setImportTab('paste')">📋 Paste CSV</button>
    </div>
    ${st.tab==='file'?`
      <div class="upload-zone" id="drop-zone" onclick="document.getElementById('file-input').click()"
        ondragover="event.preventDefault();this.classList.add('drag')"
        ondragleave="this.classList.remove('drag')"
        ondrop="handleFileDrop(event)">
        <div class="upload-icon">${st.questions.length?'✅':'📋'}</div>
        <div class="upload-title">${st.questions.length?st.questions.length+' questions loaded':'Drop CSV here'}</div>
        <div class="upload-sub">${st.questions.length?'Click to replace':'or click to browse · .csv files only'}</div>
      </div>
      <input type="file" id="file-input" accept=".csv" style="display:none" onchange="handleFileInput(event)"/>
    `:`
      <textarea class="paste-area" id="paste-area" placeholder="Paste your AI-generated CSV here…&#10;&#10;question,option_a,…,answer,explanation,subject,difficulty"
        oninput="importState.pasteText=this.value">${esc(st.pasteText)}</textarea>
      <div class="row" style="margin-top:8px">
        <button class="btn btn-ink btn-sm" onclick="parsePaste()">Parse →</button>
        ${st.questions.length?`<span style="font-size:.73rem;color:var(--emerald)">✓ ${st.questions.length} loaded</span>`:''}
      </div>
    `}
    <input type="file" id="file-input-hidden" accept=".csv" style="display:none" onchange="handleFileInput(event)"/>
    ${st.error?`<div class="alert alert-err">⚠️ ${esc(st.error)}</div>`:''}
    ${st.questions.length?`
      <div style="margin-top:15px">
        <div style="font-size:.7rem;color:var(--muted);margin-bottom:6px;font-family:'DM Mono',monospace">
          PREVIEW — ${st.questions.length} TOTAL · ${filtered.length} SELECTED
        </div>
        <div class="q-list">${st.questions.map((q,i)=>`
          <div class="q-item">
            <span class="q-num">${String(i+1).padStart(2,'0')}</span>
            <span class="q-text">${esc(q.stem.slice(0,82))}${q.stem.length>82?'…':''}</span>
            ${q.subject?`<span class="tag tag-sub">${esc(q.subject)}</span>`:''}
            <span class="tag ${diffTagCls(q.difficulty)}">${q.difficulty}</span>
          </div>`).join('')}
        </div>
      </div>`:''}
  </div>

  ${st.questions.length?`
  <div class="card">
    <div class="card-title">Filter & Select</div>
    <div class="card-sub">Narrow by subject or difficulty. Leave blank to use all.</div>
    ${subjects.length?`
      <div style="margin-bottom:9px">
        <div style="font-size:.66rem;color:var(--muted);font-family:'DM Mono',monospace;margin-bottom:5px">SUBJECTS</div>
        <div class="filter-row">
          ${subjects.map(s=>`<div class="fpill ${st.filterSubs.includes(s)?'on':''}" onclick="toggleSubFilter('${esc(s)}')">${esc(s)}</div>`).join('')}
        </div>
      </div>`:''}
    ${diffs.length?`
      <div style="margin-bottom:11px">
        <div style="font-size:.66rem;color:var(--muted);font-family:'DM Mono',monospace;margin-bottom:5px">DIFFICULTY</div>
        <div class="filter-row">
          ${['Easy','Medium','Hard'].filter(d=>diffs.includes(d)).map(d=>`
            <div class="fpill ${st.filterDiffs.includes(d)?'on':''}" onclick="toggleDiffFilter('${d}')">${d}</div>`).join('')}
        </div>
      </div>`:''}
    <div class="row">
      <label>Limit to</label>
      <input type="number" value="${esc(st.numQ)}" min="1" max="${st.questions.length}" placeholder="All"
        oninput="importState.numQ=this.value;renderImport()"/>
      <label>questions <span style="color:var(--muted)">(${filtered.length} will be used)</span></label>
    </div>
  </div>`:''}

  <div class="card">
    <div class="card-title">Session Mode</div>
    <div class="mode-grid">
      <div class="mode-card ${st.mode==='timed'?'sel':''}" onclick="setMode('timed')">
        <div class="mode-icon">⏱️</div>
        <div class="mode-name">Timed Exam</div>
        <div class="mode-desc">Race the clock. Flag questions to revisit. Answers + analytics at the end.</div>
      </div>
      <div class="mode-card ${st.mode==='revision'?'sel':''}" onclick="setMode('revision')">
        <div class="mode-icon">🔍</div>
        <div class="mode-name">Revision Mode</div>
        <div class="mode-desc">Instant answer + explanation after each question. No time pressure.</div>
      </div>
    </div>
    ${st.mode==='timed'?`
      <div class="row" style="margin-top:13px">
        <label>Time limit</label>
        <input type="number" value="${st.minutes}" min="1" max="300"
          oninput="importState.minutes=parseInt(this.value)||30"/>
        <label>minutes</label>
      </div>`:''}
    <div class="divider"></div>
    <label style="display:flex;align-items:center;gap:8px;cursor:pointer;font-size:.8rem">
      <input type="checkbox" ${st.doShuffle?'checked':''} onchange="importState.doShuffle=this.checked"/>
      Shuffle question order
    </label>
  </div>

  <div class="card">
    <div class="row">
      <div class="card-title">AI Prompt & CSV Format</div>
      <div class="spacer"></div>
      <button class="btn btn-ghost btn-sm" onclick="toggleFmt()">${st.showFmt?'Hide ▲':'Show ▼'}</button>
    </div>
    ${st.showFmt?`
      <div style="margin-top:11px">
        <div style="font-size:.77rem;color:var(--muted);margin-bottom:9px">Copy this prompt into ChatGPT / Claude / Gemini:</div>
        <div class="format-box">${esc(AI_PROMPT)}</div>
        <div class="row" style="margin-top:8px">
          <button class="copy-btn" onclick="copyPrompt()">📋 Copy Prompt</button>
          <span style="font-size:.68rem;color:var(--muted)">Supports A–E · difficulty required for analytics</span>
        </div>
      </div>`:''}
  </div>

  <div class="row" style="margin-top:20px;justify-content:flex-end">
    <button class="btn btn-ink" ${filtered.length===0?'disabled':''} onclick="startSession()">
      Begin Session (${filtered.length}q) →
    </button>
  </div>
  `}`;
}

function renderHistory(sessions){
  if(!sessions.length) return `<div class="empty"><div class="empty-icon">📭</div>No sessions saved yet. Complete a session to see history here.</div>`;
  return `
    <div class="section-title">Session History</div>
    <div class="section-sub">All sessions auto-saved. Tap to view results.</div>
    ${sessions.map(s=>{
      const score=pct(s.correct||0,s.total||1);
      const scoreColor=score>=75?'var(--emerald)':score>=50?'var(--amber)':'var(--rose)';
      const gradeLabel=score>=75?'Pass':score>=50?'Borderline':'Fail';
      const gradeClass=score>=75?'ga':score>=50?'gb':'gc';
      return `
      <div class="hist-item" onclick="viewHistorySession('${s.key}')">
        <div class="hist-top">
          <div class="hist-score" style="color:${scoreColor}">${score}%</div>
          <div style="flex:1">
            <div style="font-size:.8rem;font-weight:600">${s.correct||0}/${s.total||0} correct</div>
            <div class="hist-date">${dateStr(s.timestamp)}</div>
          </div>
          <span class="grade-pill ${gradeClass}">${gradeLabel}</span>
          <button class="btn btn-ghost btn-sm" style="color:var(--rose)"
            onclick="event.stopPropagation();deleteSession('${s.key}')">✕</button>
        </div>
        <div class="hist-chips">
          <span class="hist-chip">${s.mode==='timed'?'⏱ Timed':'🔍 Revision'}</span>
          <span class="hist-chip">${s.total||0} Qs</span>
          ${s.elapsed?`<span class="hist-chip">⏱ ${fmtTime(s.elapsed)}</span>`:''}
          ${(s.subjects||[]).slice(0,3).map(sub=>`<span class="hist-chip">${esc(sub)}</span>`).join('')}
        </div>
      </div>`;
    }).join('')}`;
}

function loadSessions(){
  const keys=DB.list('mq:session:');
  return keys.map(k=>DB.get(k)).filter(Boolean).sort((a,b)=>b.timestamp-a.timestamp);
}

function importTab(t){ importState.mainTab=t; renderImport(); }
function setImportTab(t){ importState.tab=t; renderImport(); }
function setMode(m){ importState.mode=m; renderImport(); }
function toggleFmt(){ importState.showFmt=!importState.showFmt; renderImport(); }
function toggleSubFilter(s){
  const i=importState.filterSubs.indexOf(s);
  if(i>=0) importState.filterSubs.splice(i,1); else importState.filterSubs.push(s);
  renderImport();
}
function toggleDiffFilter(d){
  const i=importState.filterDiffs.indexOf(d);
  if(i>=0) importState.filterDiffs.splice(i,1); else importState.filterDiffs.push(d);
  renderImport();
}

function handleFileDrop(e){
  e.preventDefault();
  document.getElementById('drop-zone')?.classList.remove('drag');
  const f=e.dataTransfer.files[0]; if(!f) return;
  readFile(f);
}
function handleFileInput(e){ const f=e.target.files[0]; if(!f) return; readFile(f); }
function readFile(f){
  const r=new FileReader();
  r.onload=ev=>processCSV(ev.target.result);
  r.readAsText(f);
}
function parsePaste(){
  const t=importState.pasteText;
  if(t.trim()) processCSV(t);
}
function processCSV(text){
  try{
    const parsed=parseCSV(text);
    if(!parsed.length){ importState.error='No valid questions found. Check CSV format.'; importState.questions=[]; renderImport(); return; }
    importState.questions=parsed; importState.error=''; importState.filterSubs=[]; importState.filterDiffs=[]; importState.numQ='';
    renderImport();
    toast(`✓ ${parsed.length} questions loaded`);
  }catch(e){ importState.error='Failed to parse CSV. Check the format.'; renderImport(); }
}
function copyPrompt(){
  navigator.clipboard.writeText(AI_PROMPT).then(()=>toast('📋 Prompt copied!')).catch(()=>{
    // fallback
    const ta=document.createElement('textarea');
    ta.value=AI_PROMPT; document.body.appendChild(ta); ta.select();
    document.execCommand('copy'); document.body.removeChild(ta);
    toast('📋 Prompt copied!');
  });
}

function startSession(){
  const st=importState;
  let qs=importState._filtered||st.questions;
  if(st.doShuffle) qs=shuffle(qs);
  if(!qs.length) return;
  APP.questions=qs;
  APP.mode=st.mode;
  APP.minutes=st.minutes;
  APP.sessionKey='mq:session:'+Date.now();
  beginTest();
}

function deleteSession(key){
  DB.del(key); renderImport();
  toast('Session deleted');
}

function viewHistorySession(key){
  const s=DB.get(key);
  if(!s||!s.finished) return toast('Incomplete session');
  APP.result={
    questions:s.questions,answers:s.answers,confidence:s.confidence||[],
    flags:s.flags||[],qTimes:s.qTimes||[],elapsed:s.elapsed,mode:s.mode,
    fromHistory:true
  };
  renderResults();
  goTo('results');
}

/* ═══════════════════════════════════════════════════════════
   TEST ENGINE
═══════════════════════════════════════════════════════════*/
function beginTest(){
  const n=APP.questions.length;
  APP.idx=0;
  APP.answers=Array(n).fill(null);
  APP.revealed=Array(n).fill(false);
  APP.confidence=Array(n).fill(null);
  APP.flags=Array(n).fill('none');
  APP.qTimes=Array(n).fill(0);
  APP.timeLeft=APP.mode==='timed'?APP.minutes*60:null;
  APP.sessionStart=Date.now();
  APP.qStart=Date.now();
  clearInterval(APP.timerInterval);
  clearInterval(APP.autoSaveInterval);
  if(APP.mode==='timed'){
    APP.timerInterval=setInterval(tickTimer,1000);
  }
  APP.autoSaveInterval=setInterval(autoSave,15000);
  renderTest();
  goTo('test');
}

function tickTimer(){
  if(APP.timeLeft===null) return;
  APP.timeLeft--;
  // update timer display only
  const tb=document.getElementById('timer-bar');
  const tt=document.getElementById('timer-txt');
  if(tb){
    const total=APP.minutes*60;
    const p=(APP.timeLeft/total)*100;
    tb.style.width=p+'%';
    tb.style.background=APP.timeLeft<60?'var(--rose)':p>50?'var(--emerald)':'var(--amber)';
  }
  if(tt){
    tt.textContent=fmtTime(APP.timeLeft);
    if(APP.timeLeft<60) tt.classList.add('warn'); else tt.classList.remove('warn');
  }
  // Update sidebar answered count
  updateSidebarStats();
  if(APP.timeLeft<=0) submitTest();
}

function autoSave(){
  showAutosave('saving');
  const snap={
    key:APP.sessionKey,
    questions:APP.questions,mode:APP.mode,minutes:APP.minutes,
    answers:APP.answers,revealed:APP.revealed,confidence:APP.confidence,
    flags:APP.flags,qTimes:APP.qTimes,timeLeft:APP.timeLeft,lastIdx:APP.idx,
    timestamp:Date.now(),finished:false,
    elapsed:Math.round((Date.now()-APP.sessionStart)/1000),
  };
  DB.set(APP.sessionKey,snap);
  setTimeout(()=>showAutosave('saved'),400);
}

function recordQTime(){
  const elapsed=Math.round((Date.now()-APP.qStart)/1000);
  APP.qTimes[APP.idx]=(APP.qTimes[APP.idx]||0)+elapsed;
}

function navTo(i){
  recordQTime();
  APP.idx=i;
  APP.qStart=Date.now();
  renderQuestion();
  renderSidebar();
}

function chooseAnswer(oi){
  if(APP.revealed[APP.idx]) return;
  APP.answers[APP.idx]=oi;
  if(APP.mode==='revision'){
    APP.revealed[APP.idx]=true;
    renderQuestion();
  } else {
    // just update the option styles
    renderQuestion();
  }
  renderSidebar();
}

function setFlag(f){
  APP.flags[APP.idx]=f;
  renderFlagPanel();
  renderSidebar();
}

function setConfidence(c){
  APP.confidence[APP.idx]=c;
  renderConfidence();
}

function submitTest(){
  clearInterval(APP.timerInterval);
  clearInterval(APP.autoSaveInterval);
  recordQTime();
  const elapsed=Math.round((Date.now()-APP.sessionStart)/1000);
  const correct=APP.answers.filter((a,i)=>a===APP.questions[i].correctIndex).length;
  const subjects=[...new Set(APP.questions.map(q=>q.subject).filter(Boolean))];
  DB.set(APP.sessionKey,{
    key:APP.sessionKey,questions:APP.questions,mode:APP.mode,minutes:APP.minutes,
    answers:APP.answers,confidence:APP.confidence,flags:APP.flags,qTimes:APP.qTimes,
    elapsed,correct,total:APP.questions.length,subjects,timestamp:Date.now(),finished:true,
  });
  APP.result={
    questions:APP.questions,answers:APP.answers,confidence:APP.confidence,
    flags:APP.flags,qTimes:APP.qTimes,elapsed,mode:APP.mode,
  };
  renderResults();
  goTo('results');
}

