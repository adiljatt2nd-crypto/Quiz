  <div class="tabs" id="review-tabs">
    <button class="tab active" onclick="setRevTab('all','${score}')">All (${questions.length})</button>
    <button class="tab" onclick="setRevTab('wrong','${score}')">❌ Wrong (${wrongQs.length})</button>
    ${flaggedQs.length?`<button class="tab" onclick="setRevTab('flagged','${score}')">🚩 (${flaggedQs.length})</button>`:''}
    ${reviewQs.length?`<button class="tab" onclick="setRevTab('review','${score}')">🔖 (${reviewQs.length})</button>`:''}
    ${unsureQs.length?`<button class="tab" onclick="setRevTab('unsure','${score}')">❓ (${unsureQs.length})</button>`:''}
  </div>
  <div id="review-list"></div>
  <div class="btn-group" style="margin-top:22px;justify-content:center">
    ${wrongQs.length?`<button class="btn btn-rose" onclick="retryWrong()">🔁 Retry Wrong</button>`:''}
    <button class="btn btn-ink" onclick="goHome()">← New Session</button>
  </div>`;

  renderReviewList();
}

function setRevTab(tab){
  revTab=tab; openReviewIdx=null;
  document.querySelectorAll('#review-tabs .tab').forEach(t=>t.classList.remove('active'));
  event.target.classList.add('active');
  renderReviewList();
}

function renderReviewList(){
  const r=APP.result; if(!r) return;
  const {questions,answers,confidence,flags,qTimes}=r;
  const map={
    all:questions.map((q,i)=>({q,i})),
    wrong:questions.map((q,i)=>({q,i})).filter(({i})=>answers[i]!==null&&answers[i]!==questions[i].correctIndex),
    flagged:questions.map((q,i)=>({q,i})).filter(({i})=>flags?.[i]&&flags[i]!=='none'),
    review:questions.map((q,i)=>({q,i})).filter(({i})=>flags?.[i]==='review'),
    unsure:questions.map((q,i)=>({q,i})).filter(({i})=>flags?.[i]==='unsure'),
  };
  const list=map[revTab]||map.all;
  const el=document.getElementById('review-list');
  if(!el) return;
  if(!list.length){ el.innerHTML='<div class="empty">Nothing here.</div>'; return; }

  el.innerHTML=list.map(({q,i})=>{
    const ans=answers[i]; const isOk=ans===q.correctIndex; const isSkip=ans===null;
    const conf=confidence?.[i]; const qt=qTimes?.[i]; const fl=flags?.[i];
    const open=openReviewIdx===i;
    const flagLabel={review:'🔖 Review',unsure:'❓ Unsure',skip:'⏭ Skip'}[fl]||'';
    return `
    <div class="review-item" id="ri-${i}">
      <div class="review-hdr" onclick="toggleReview(${i})">
        <div class="rstatus ${isSkip?'rs-skip':isOk?'rs-ok':'rs-bad'}">${isSkip?'—':isOk?'✓':'✗'}</div>
        <div class="review-q">${i+1}. ${esc(q.stem.slice(0,75))}${q.stem.length>75?'…':''}</div>
        <span style="color:var(--muted);font-size:.73rem">${open?'▲':'▼'}</span>
      </div>
      <div class="review-body ${open?'open':''}" id="rb-${i}">
        <div class="rmeta">
          ${q.subject?`<span class="tag tag-sub">${esc(q.subject)}</span>`:''}
          ${q.difficulty?`<span class="tag ${diffTagCls(q.difficulty)}">${q.difficulty}</span>`:''}
          ${conf?`<span class="tag tag-sky">${conf==='sure'?'✓ Sure':conf==='unsure'?'~ Unsure':'? Guess'}</span>`:''}
          ${qt>0?`<span class="tag tag-muted">${qt}s</span>`:''}
          ${fl&&fl!=='none'?`<span class="tag tag-violet">${flagLabel}</span>`:''}
        </div>
        ${q.options.map((opt,oi)=>{
          let cls='ropt';
          if(oi===q.correctIndex) cls+=' correct';
          else if(oi===ans) cls+=' wrong';
          return `<div class="${cls}">${LETTERS[oi]}. ${esc(opt)}${oi===q.correctIndex?' ✓':''}${oi===ans&&oi!==q.correctIndex?' ✗ (yours)':''}</div>`;
        }).join('')}
        ${q.explanation?`<div class="explanation" style="margin-top:9px"><div class="expl-lbl">EXPLANATION</div>${esc(q.explanation)}</div>`:''}
      </div>
    </div>`;
  }).join('');
}

function toggleReview(i){
  openReviewIdx=openReviewIdx===i?null:i;
  renderReviewList();
  if(openReviewIdx!==null){
    setTimeout(()=>{
      const el=document.getElementById('ri-'+i);
      if(el) el.scrollIntoView({behavior:'smooth',block:'nearest'});
    },50);
  }
}

function retryWrong(){
  const r=APP.result; if(!r) return;
  const wrongQs=r.questions.filter((_,i)=>r.answers[i]!==null&&r.answers[i]!==r.questions[i].correctIndex);
  if(!wrongQs.length) return;
  APP.questions=wrongQs;
  APP.sessionKey='mq:session:'+Date.now();
  beginTest();
}
function retryReview(){
  const r=APP.result; if(!r) return;
  const rQs=r.questions.filter((_,i)=>r.flags?.[i]==='review');
  if(!rQs.length) return;
  APP.questions=rQs;
  APP.sessionKey='mq:session:'+Date.now();
  beginTest();
}

/* ═══════════════════════════════════════════════════════════
   PWA / SERVICE WORKER
═══════════════════════════════════════════════════════════*/
let deferredPrompt=null;
window.addEventListener('beforeinstallprompt',e=>{
  e.preventDefault(); deferredPrompt=e;
  const banner=document.getElementById('install-banner');
  if(banner) banner.classList.add('show');
});
document.getElementById('install-btn')?.addEventListener('click',async()=>{
  if(!deferredPrompt) return;
  deferredPrompt.prompt();
  const {outcome}=await deferredPrompt.userChoice;
  deferredPrompt=null;
  document.getElementById('install-banner')?.classList.remove('show');
});
document.getElementById('dismiss-banner')?.addEventListener('click',()=>{
  document.getElementById('install-banner')?.classList.remove('show');
});
window.addEventListener('appinstalled',()=>toast('✓ MedQuiz PRO installed!',3000));

/* inline SW for offline support */
if('serviceWorker' in navigator){
  const swContent=`
    const CACHE='medquiz-v1';
    self.addEventListener('install',e=>{ self.skipWaiting(); });
    self.addEventListener('activate',e=>{ e.waitUntil(caches.keys().then(ks=>Promise.all(ks.filter(k=>k!==CACHE).map(k=>caches.delete(k))))); });
    self.addEventListener('fetch',e=>{
      if(e.request.method!=='GET') return;
      e.respondWith(caches.open(CACHE).then(cache=>
        fetch(e.request).then(r=>{ cache.put(e.request,r.clone()); return r; }).catch(()=>caches.match(e.request))
      ));
    });`;
  const blob=new Blob([swContent],{type:'application/javascript'});
  const swUrl=URL.createObjectURL(blob);
  navigator.serviceWorker.register(swUrl).catch(()=>{});
}

