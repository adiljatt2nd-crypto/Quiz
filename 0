let revTab='all';
let openReviewIdx=null;

function renderResults(){
  const r=APP.result;
  if(!r) return;
  const {questions,answers,confidence,flags,qTimes,elapsed,mode}=r;
  const correct=answers.filter((a,i)=>a===questions[i].correctIndex).length;
  const skipped=answers.filter(a=>a===null).length;
  const wrong=questions.length-correct-skipped;
  const score=pct(correct,questions.length);
  const grade=score>=75?{l:'Pass ✦',c:'ga'}:score>=50?{l:'Borderline',c:'gb'}:{l:'Needs Work',c:'gc'};
  const avgTime=qTimes?.length?Math.round(qTimes.reduce((a,b)=>a+b,0)/qTimes.length):0;
  const wrongQs=questions.filter((_,i)=>answers[i]!==null&&answers[i]!==questions[i].correctIndex);
  const reviewQs=questions.filter((_,i)=>flags?.[i]==='review');
  const unsureQs=questions.filter((_,i)=>flags?.[i]==='unsure');
  const flaggedQs=questions.filter((_,i)=>flags?.[i]&&flags[i]!=='none');

  revTab='all'; openReviewIdx=null;

  document.getElementById('screen-results').innerHTML=`
  <div class="card" style="margin-bottom:14px">
    <div class="result-hero">
      <div class="big-score" style="color:${score>=75?'var(--emerald)':score>=50?'var(--amber)':'var(--rose)'}">${score}%</div>
      <div class="result-lbl">${correct} of ${questions.length} correct</div>
      <span class="grade-pill ${grade.c}">${grade.l}</span>
    </div>
    <div class="stat-grid">
      <div class="stat-box"><div class="sv g">${correct}</div><div class="sl">Correct</div></div>
      <div class="stat-box"><div class="sv r">${wrong}</div><div class="sl">Wrong</div></div>
      <div class="stat-box"><div class="sv m">${skipped}</div><div class="sl">Skipped</div></div>
      <div class="stat-box"><div class="sv b">${fmtTime(elapsed)}</div><div class="sl">Time</div></div>
    </div>
    ${avgTime?`<div style="text-align:center;font-size:.72rem;color:var(--muted);font-family:'DM Mono',monospace;margin-bottom:12px">avg ${avgTime}s per question</div>`:''}
    <div class="btn-group" style="justify-content:center">
      ${wrongQs.length?`<button class="btn btn-rose" onclick="retryWrong()">🔁 Retry ${wrongQs.length} Wrong</button>`:''}
      ${reviewQs.length?`<button class="btn btn-amber" onclick="retryReview()">🔖 Retry Marked (${reviewQs.length})</button>`:''}
      ${!r.fromHistory?'':''}
      <button class="btn btn-outline" onclick="goHome()">← New Session</button>
    </div>
  </div>

  ${renderAnalyticsHTML(questions,answers,confidence||[],qTimes||[])}

  <div class="divider"></div>
